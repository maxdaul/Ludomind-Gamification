DB_PORT=5433
DB_USER=postgres
DB_NAME=postgres
YANDEX_API_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DB_NAME_TEST=tests
TESTING=false
INIT_DB=false
